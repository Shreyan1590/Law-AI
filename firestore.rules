rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Match users collection
    match /users/{userEmail} {
      allow read, write: if isAuthenticated() && request.auth.token.email == userEmail;
    }

    // Match history collection
    match /history/{historyId} {
      allow read, create, delete: if isAuthenticated() && (
        // For existing documents (read / delete)
        (resource != null && request.auth.token.email == resource.data.userEmail) ||
        // For new documents (create)
        (resource == null && request.auth.token.email == request.resource.data.userEmail)
      );
    }
  }
}
